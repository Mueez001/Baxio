# FormSubmit AJAX endpoint the contact form posts to. This is the delivery inbox
# for submissions, not the public contact email (that is contact.email in
# src/content/site.js). Contact.jsx falls back to this value when unset.
VITE_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/mueez@go2baxio.com

# Analytics (src/lib/analytics.js). Leave empty to keep tracking off. Production builds read
# these from the GitHub repository variables GA_MEASUREMENT_ID and CLARITY_PROJECT_ID.
# Set VITE_ANALYTICS_DEV=true to test tracking in `npm run dev`.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_ANALYTICS_DEV=

# Where chat-assistant intakes are emailed. ChatbotWidget.jsx posts straight to
# FormSubmit and falls back to leadEndpoint in src/content/site.js when unset.
# (The Vercel relay in backend/vercel is no longer called by the site.)
VITE_CHATBOT_ENDPOINT=https://formsubmit.co/ajax/mueez@go2baxio.com

# Optional: Web3Forms access key for the lead inbox (mueez@go2baxio.com). When set, contact-form and
# chat leads go through Web3Forms instead of FormSubmit. In GitHub: repository variable WEB3FORMS_KEY.
VITE_WEB3FORMS_KEY=
